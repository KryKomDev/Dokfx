{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../MyLibrary",
          "files": [
            "**/*.csproj"
          ]
        }
      ],
      "dest": "api",
      "memberLayout": "separatePages"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "_site/**"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      },
      {
        "src": "../../scripts",
        "files": [
          "install.ps1",
          "install.sh"
        ],
        "dest": "."
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern",
      "../../src/dokfx"
    ],
    "markdownEngineProperties": {
      "alerts": {
        "todo": "alert alert-todo todo"
      }
    },
    "globalMetadata": {
      "_appName": "Dokfx",
      "_appTitle": "Dokfx Theme",
      "_gitRepo": "https://github.com/KryKomDev/Dokfx",
      "_accentColor": "#9800f8",
      "_calloutNoteHeading": "Did you know?",
      "_calloutTipHeading": "Pro Tip",
      "_customCallouts": [
        {
          "name": "todo",
          "heading": "Things to Do",
          "color": "#908ca1",
          "icon": "checklist"
        }
      ],
      "_appLogoPath": "images/Gen17.png",
      "_appFaviconPath": "images/Gen17.png",
      "_enableSearch": true,
      "pdf": false
    }
  }
}