{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../MyLibrary",
          "files": [
            "**/*.csproj"
          ]
        }
      ],
      "dest": "api",
      "memberLayout": "separatePages"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "_site/**",
          "namespaces.md"
        ]
      }
    ],
    "overwrite": [
      {
        "files": [
          "namespaces.md"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      },
      {
        "src": "../../scripts",
        "files": [
          "install.ps1",
          "install.sh"
        ],
        "dest": "."
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern",
      "../../src/dokfx"
    ],
    "markdownEngineProperties": {
      "alerts": {
        "todo": "alert alert-todo todo"
      }
    },
    "globalMetadata": {
      "_appName": "Dokfx",
      "_appTitle": "Dokfx Theme",
      "_gitRepo": "https://github.com/KryKomDev/Dokfx",
      "_accentColor": "#9800f8",
      "_calloutTipHeading": "Pro Tip",
      "_calloutImportantHeading": "Crucial",
      "_customCallouts": [
        {
          "name": "todo",
          "heading": "Things to Do",
          "color": "#908ca1",
          "icon": "checklist"
        }
      ],
      "_appLogoPath": "images/Gen17.png",
      "_appFaviconPath": "images/Gen17.png",
      "_enableSearch": true,
      "_reworkedApiLayout": true,
      "_appFooter": "<span>Copyright &copy; 2026 KryKom · Licensed under the MIT License · Source code on <a href='https://github.com/KryKomDev/Dokfx' target='_blank'>GitHub</a> · Generated with <a href='https://dotnet.github.io/docfx/' target='_blank'>DocFX</a> using the <a href='https://github.com/KryKomDev/Dokfx' target='_blank'>Dokfx template</a></span>",
      "pdf": false
    }
  }
}